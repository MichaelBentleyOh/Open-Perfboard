{
  "name": "open-perfboard",
  "productName": "Open Perfboard",
  "version": "1.0.0",
  "description": "오프라인 실배선도 에디터",
  "main": "./out/main/index.js",
  "private": true,
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/MichaelBentleyOh/Open-Perfboard",
  "repository": {
    "type": "git",
    "url": "https://github.com/MichaelBentleyOh/Open-Perfboard.git"
  },
  "bugs": {
    "url": "https://github.com/MichaelBentleyOh/Open-Perfboard/issues"
  },
  "author": {
    "name": "Minsik Oh",
    "email": "michael1015999@gmail.com"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "electron-vite build && playwright test",
    "check": "npm run typecheck && npm run test",
    "perf": "vitest run -c vitest.perf.config.ts",
    "perf:e2e": "electron-vite build && playwright test -c playwright.perf.config.ts",
    "build:icon": "electron scripts/build-icon.mjs",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "screenshots": "electron-vite build && playwright test -c playwright.readme.config.ts screenshots.spec",
    "screenshots:gif": "electron-vite build && playwright test -c playwright.readme.config.ts demo.spec",
    "test:packaged": "node scripts/test-packaged.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "konva": "^10.7.0",
    "nanoid": "^6.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-konva": "^19.3.0",
    "zundo": "^2.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "gifenc": "^1.0.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  }
}
